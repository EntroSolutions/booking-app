# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking?schema=public"

# Secret used by Auth.js for tokens/cookies. Server-only: never prefix with
# NEXT_PUBLIC_. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Canonical URL Auth.js uses to build magic links. Keep equal to APP_URL.
AUTH_URL="http://localhost:3000"

# Comma-separated emails that get the COACH role when they first sign in.
# Everyone else becomes a CLIENT. Roles are never chosen by the user.
COACH_EMAILS="coach@example.com"

# Resend API key for sending transactional emails. Leave empty in local
# development: sign-in links are printed to the dev server console instead.
RESEND_API_KEY=""

# From address for outgoing emails
EMAIL_FROM="Bookings <no-reply@example.com>"

# Public base URL of the app
APP_URL="http://localhost:3000"
