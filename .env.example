# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking?schema=public"

# Secret used for signing auth sessions
AUTH_SECRET="change-me"

# Resend API key for sending transactional emails
RESEND_API_KEY=""

# From address for outgoing emails
EMAIL_FROM="Bookings <no-reply@example.com>"

# Public base URL of the app
APP_URL="http://localhost:3000"
